{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "default_locale": "en",
  "version": "1.0.9",
  "homepage_url": "https://github.com/noumenonnn/numera-widget",
  "browser_specific_settings": {
    "gecko": {
      "id": "numera@numera.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["selection.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "tooltip/arrow-light.svg",
        "tooltip/arrow-dark.svg",
        "tooltip/geist-latin.woff2"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "host_permissions": [
    "https://data-api.binance.vision/*",
    "https://api.frankfurter.dev/*",
    "https://api.kraken.com/*"
  ],
  "action": {
    "default_title": "Numera",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/numera-16.png",
      "32": "icons/numera-32.png",
      "48": "icons/numera-48.png",
      "128": "icons/numera-128.png"
    }
  },
  "icons": {
    "16": "icons/numera-16.png",
    "32": "icons/numera-32.png",
    "48": "icons/numera-48.png",
    "128": "icons/numera-128.png"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "incognito": "not_allowed",
  "optional_host_permissions": [
    "https://data-api.binance.vision/*",
    "https://api.frankfurter.dev/*",
    "https://api.kraken.com/*"
  ]
}
